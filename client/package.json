{
  "name": "screen-2-screen-client",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn/ui shared-screen workspace built on the Neko v3 client and core.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace=@m1k1o/neko && tsc --noEmit && vite build && node tools/dist.check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node e2e.mjs",
    "format": "prettier --write .",
    "check": "run-p -l --aggregate-output check:types check:format check:lint check:cycles test && npm run build && node core/dist.check.mjs",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check .",
    "check:lint": "eslint src core/src",
    "check:cycles": "node tools/cycles.mjs",
    "check:dist": "node core/dist.check.mjs",
    "build:emoji": "node tools/emoji.ts",
    "build:core": "npm --prefix core run build",
    "dev:demo": "vite --mode demo"
  },
  "dependencies": {
    "@radix-ui/react-menu": "^2.1.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15",
    "radix-ui": "1.8.1",
    "lucide-react": "1.72.0",
    "tw-animate-css": "1.4.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "emoji-datasource": "^6.1.1",
    "emojilib": "3.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
